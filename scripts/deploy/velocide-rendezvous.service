# VELOCIDE's online service (docs/rendezvous.md). Installed by setup-vps.sh.
#
# Runs the release /opt/velocide/deploy/current points at, as a throwaway user in a sandbox:
# it only needs UDP and its state directory (the master key). It exits by itself when a deploy
# points current at a new release, and systemd starts the new binary; with the same key, hosts
# keep their codes and relayed games carry on.
[Unit]
Description=VELOCIDE online service (listings, join codes, hole punching, relay)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
ExecStart=/opt/velocide/deploy/current/velocide-rendezvous --bind 0.0.0.0:47400 --exit-when-replaced /opt/velocide/deploy/current/velocide-rendezvous
Restart=always
RestartSec=2
DynamicUser=yes
StateDirectory=velocide-rendezvous
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
MemoryMax=256M
TasksMax=16
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
