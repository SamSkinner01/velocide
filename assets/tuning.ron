// VELOCIDE gameplay tuning. Watched at runtime: save to hot-reload. The server is
// authoritative and sends its tuning to clients, so prediction always uses the same values.
// Every section uses defaults for anything left out (see shared/src/tuning.rs); `net` is
// omitted here and uses its code defaults.
//
// Units: metres, m/s, m/s², seconds, degrees. Rationale for each value: docs/movement.md
// (movement) and docs/gameplay.md / docs/combat.md (combat).
// Keep these equal to `MovementTuning::default()` / `CombatTuning::default()` when committing
// (tests check both).
(
    movement: (
        // Body
        radius: 0.4,
        standing_height: 1.8,
        slide_height: 0.9,
        eye_height: 1.6,
        slide_eye_height: 0.75,
        step_height: 0.45,
        max_ground_slope_degrees: 50.0,

        // Ground / air
        ground_speed: 16.0,
        ground_accel: 160.0,          // 0 -> 16 m/s in 0.1 s
        ground_overspeed_decel: 30.0, // bleed-off above ground_speed while running
        ground_friction: 10.0,        // only without input
        ground_stop_speed: 4.0,
        air_accel: 70.0,
        air_max_speed: 16.0,          // air control never adds or removes speed above this
        gravity: 38.0,
        max_fall_speed: 90.0,
        max_speed: 150.0,             // hard safety cap (stacked explosions)
        jump_speed: 14.0,             // ~2.5 m jump
        coyote_time: 0.12,
        jump_buffer_time: 0.12,
        footstep_stride: 2.6,

        // Dash
        dash_speed: 48.0,
        dash_duration: 0.17,          // ~8.8 m per dash
        dash_invuln_time: 0.2,
        dash_charges: 3.0,
        dash_regen_rate: 0.85,        // charges per second
        dash_end_speed: 20.0,
        dash_jump_keep: 0.6,          // dash-jump leaves at 28.8 m/s

        // Slide
        slide_min_speed: 24.0,
        slide_max_speed: 60.0,
        slide_steer_degrees: 70.0,
        slide_slope_accel: 1.0,
        slide_jump_boost: 1.0,

        // Slam
        slam_speed: 75.0,
        slam_min_height: 1.0,
        slam_horizontal_keep: 0.0,
        slam_full_power_height: 15.0,
        slam_bounce_window: 0.2,
        slam_bounce_speed: 21.0,      // ~5.8 m bounce (vs 2.5 m jump)
        slam_bounce_power_bonus: 5.0, // up to ~8.9 m from a full-power slam
        slam_shockwave_radius: 6.0,

        // Walls
        wall_jumps: 3,
        wall_jump_up_speed: 13.0,
        wall_jump_out_speed: 11.0,
        wall_jump_input_speed: 4.0,
        wall_cling_max_fall_speed: 4.0,
        wall_detect_distance: 0.4,

        // Camera feel (client only)
        fov_kick_degrees: 10.0,
        fov_kick_speed: 45.0,
        slide_tilt_degrees: 4.0,
        wall_tilt_degrees: 7.0,
        landing_dip: 0.25,
    ),

    // Combat. HP, metres, m/s, seconds; cones are full apertures in degrees.
    combat: (
        // Player
        max_health: 100.0,
        hard_damage_fraction: 0.35,     // of every hit also lowers the effective max
        hard_damage_recover_delay: 1.5,
        hard_damage_recover_rate: 25.0, // HP/s
        respawn_delay: 2.0,             // default death rule (game modes replace it)
        spawn_protection: 1.5,
        player_head_multiplier: 2.0,    // PvP headshots
        self_damage_fraction: 0.35,     // own explosions (knockback stays full: blast jumps)
        hitscan_range: 400.0,
        projectile_hit_pad: 0.2,        // player projectiles vs targets (not the level): radius + this

        // Fist / parry
        parry_window: 0.2,
        parry_range: 3.0,
        parry_cone_degrees: 70.0,
        parry_close_range: 1.2,          // touching-close: any angle in front
        parry_speed_multiplier: 1.5,
        parry_damage_multiplier: 2.0,
        parry_max_speed: 250.0,          // repeated parries stop speeding a projectile up here
        parry_max_damage: 400.0,         // ... and doubling its (direct / explosion) damage here
        parry_auto_aim_degrees: 15.0,
        parry_auto_aim_range: 80.0,
        parry_hard_damage_clear: 0.5,
        parry_compensate_view_lag: true, // delay parryable hits by the victim's view lag too
        melee_parry_range: 4.0,
        punch_damage: 25.0,
        punch_range: 2.6,
        punch_cone_degrees: 50.0,
        punch_knockback: 10.0,
        punch_cooldown: 0.4,

        // Explosions
        explosion_edge_fraction: 0.3, // 100 % at the centre -> 30 % at the radius
        explosion_up_bias: 0.3,

        // Slam shockwave (radius: movement.slam_shockwave_radius)
        slam_damage: 20.0,
        slam_knockback: 12.0,
        slam_min_power_scale: 0.3,

        // Ember bursts (kindling): every hit sheds embers the closest Shrike draws in.
        embers: (
            heal_fraction: 0.4,       // of damage dealt becomes the burst's heal pool
            melee_heal_fraction: 1.0, // punches and parries
            melee_weapon_heal_fraction: 0.5, // the melee weapons' strikes
            radius: 3.5,
            lifetime: 0.6,
            death_pool: 25.0,
            death_radius: 4.5,
            death_lifetime: 1.0,
            merge_distance: 1.0,
            merge_window: 0.2,
        ),
        // Hit assist: player-owned attacks test against shapes this much bigger (m). The Moulds'
        // hit shapes already cover their (scaled-up) models; the pads reach past them.
        hit_assist: (
            enemy_body_pad: 0.35,
            enemy_weak_pad: 0.15, // weak points / heads
            player_body_pad: 0.12, // PvP
            player_head_pad: 0.06,
        ),
        // Thrown relay spikes: plant in the world; shots and blows relay off them.
        thorn: (
            charges: 3,
            recharge_time: 3.0,
            throw_speed: 30.0,
            inherit_velocity: 0.5, // of the thrower's velocity
            gravity: 12.0,
            flight_time: 3.0,      // fizzles if it never hits anything
            lifetime: 8.0,         // once planted / lying
            radius: 0.08,
            damage: 8.0,           // hitting a target (it then drops and lies as a live thorn)
            ricochet_radius: 0.6,
            chain_range: 30.0,     // next thorn, else a branded hostile, else the nearest hostile
            target_range: 40.0,
            damage_multiplier: 1.5, // per bounce
        ),
        // 1: precision spike-caster (hitscan). Defaults Brand, Wickline.
        quill: (
            damage: 24.0,
            interval: 0.28,
            brand_damage: 10.0,
            brand_cooldown: 2.5,
            brand_duration: 5.0,
            brand_multiplier: 1.35, // branded targets take this much damage from everything
            ability_power: 1.0,     // abilities on it vs on their home weapon (docs/arsenal.md)
        ),
        // 2: twin-barrel blast cannon. Defaults Gust, Bulwark.
        bellows: (
            pellets: 12,
            pellet_damage: 11.0,   // 8: top DPS on paper, weak in play (docs/balance.md, "Shotguns")
            cone_degrees: 8.0,     // the fixed pattern's outer ring (1 + 5 at half of it + 6)
            pellet_range: 60.0,
            interval: 0.8,
            pellet_knockback: 1.3, // a blast staggers now: at 2.0 it would fling a Gnawer ~10 m
            pattern_jitter_degrees: 0.5,
            point_blank_range: 3.0,      // pellets hitting within 3 m deal x1.25 ...
            point_blank_end: 4.0,        // ... back to x1 at 4 m
            point_blank_multiplier: 1.25,
            stagger_fraction: 0.34, // 4 of the 12 pellets on a light Mould stagger it ...
            stagger_time: 0.35,     // ... this long
            gust_range: 7.0,
            gust_cone_degrees: 60.0,
            gust_damage: 6.0,
            gust_knockback: 18.0,
            gust_up: 4.0,
            gust_recoil: 10.0,     // gust-jump
            gust_cooldown: 1.6,
            deflect_speed_multiplier: 1.25, // hostile projectiles caught in the gust
            deflect_damage_multiplier: 1.5,
            ability_power: 1.0,
        ),
        // 3: arc caster. Defaults Wisp, Discharge (hold to charge, release).
        arclash: (
            zap_interval: 0.1,
            zap_range: 30.0,
            zap_damage: 7.0,       // 70 DPS: at 6 the lowest hitscan primary by far (docs/balance.md)
            chain_range: 7.0,
            chain_jumps: 2,
            chain_falloff: 0.75,   // per jump
            wisp_orbit_radius: 1.6, // the Wisp orbits you (docs/rework.md) ...
            wisp_orbit_height: 1.2, // ... at chest height ...
            wisp_orbit_rate: 240.0, // ... degrees per second ...
            wisp_orbit_time: 6.0,   // ... for this long
            wisp_speed: 18.0,      // flung (ALT again): along the aim ...
            wisp_lifetime: 2.0,    // ... popping on the first contact or after this
            wisp_radius: 0.3,
            wisp_zap_interval: 0.25,
            wisp_zap_range: 7.0,
            wisp_zap_damage: 9.0,
            wisp_pop_radius: 4.0,
            wisp_pop_damage: 35.0,
            wisp_pop_knockback: 8.0,
            wisp_cooldown: 4.0,    // starts when it is gone
            discharge_charge_time: 1.0,
            discharge_min_radius: 3.5,
            discharge_max_radius: 8.0,
            discharge_min_damage: 25.0,
            discharge_max_damage: 80.0,
            discharge_min_knockback: 12.0,
            discharge_max_knockback: 24.0,
            discharge_cooldown: 2.0,
            ability_power: 1.0,
        ),
        // 4: bouncing-bomb launcher. Alt A Breach, alt B Gravewell.
        tumbler: (
            bomb_speed: 30.0,
            bomb_gravity: 18.0,
            bomb_restitution: 0.6,
            bomb_contacts: 3,      // explodes on this world contact, on a hostile, or ...
            bomb_fuse: 1.6,        // ... after this long
            bomb_projectile_radius: 0.2,
            bomb_radius: 4.5,
            bomb_damage: 72.0,     // the heavier explosive: more per bomb than a rocket salvo's share (docs/balance.md)
            bomb_knockback: 20.0,
            interval: 0.85,
            breach_reach: 3.0,
            breach_pullback: 0.2,
            breach_radius: 4.0,
            breach_damage: 70.0,
            breach_knockback: 24.0,
            breach_cooldown: 1.2,
            gravewell_speed: 20.0,
            gravewell_angle_degrees: 25.0,
            gravewell_gravity: 20.0,
            gravewell_projectile_radius: 0.25,
            gravewell_flight_time: 5.0,
            gravewell_pull_time: 1.5,  // pulls once stuck, then implodes
            gravewell_pull_radius: 9.0,
            gravewell_pull_speed: 9.0,
            gravewell_player_pull: 0.5, // PvP
            gravewell_radius: 5.0,
            gravewell_damage: 80.0,
            gravewell_knockback: 6.0,
            gravewell_cooldown: 3.0,
            ability_power: 1.0,
        ),
        // ---- expansion arsenal (docs/arsenal.md) ----
        // Needle pistol (hitscan, Precision). Spamming it blooms the spread.
        lancet: (
            damage: 14.0,
            interval: 0.15,
            bloom_per_shot: 0.25,  // heat per shot (s), drains in real time ...
            bloom_max: 0.6,        // ... up to this ...
            bloom_degrees: 3.0,    // ... spread at full heat (sustained fire settles at 75 %)
            ability_power: 0.85,
        ),
        // Drum-fed auto-scattergun (Scatter), automatic while held.
        thresher: (
            pellets: 8,            // 7 x 7.5: top DPS on paper, weak in play (docs/balance.md)
            pellet_damage: 10.0,
            cone_degrees: 10.0,    // the fixed pattern's outer ring (1 + 3 at half of it + 4)
            pellet_range: 45.0,
            interval: 0.42,
            pellet_knockback: 0.7, // every blast staggers a light Mould briefly
            pattern_jitter_degrees: 0.6,
            point_blank_range: 3.0,
            point_blank_end: 4.0,
            point_blank_multiplier: 1.0, // the sustained one: no point-blank bonus
            stagger_fraction: 0.375, // 3 of the 8 pellets
            stagger_time: 0.2,
            ability_power: 0.9,
        ),
        // Pneumatic rivet driver (Rapid): fast hot rivets with light gravity.
        riveter: (
            damage: 7.0,
            interval: 0.09,        // 5 ticks at 60 Hz: 12 rivets/s
            rivet_speed: 90.0,
            rivet_gravity: 6.0,
            rivet_radius: 0.06,
            rivet_lifetime: 1.5,
            spread_degrees: 1.2,
            ability_power: 0.9,
        ),
        // Box launcher (Explosive): one pull = a salvo of cinder rockets.
        cinderbox: (
            rockets: 3,
            salvo_gap: 0.08,
            interval: 1.3,
            rocket_speed: 42.0,
            rocket_radius: 0.15,
            rocket_lifetime: 2.5,
            spread_degrees: 2.5,
            explosion_radius: 2.6,
            damage: 32.0,
            knockback: 14.0,
            ability_power: 0.95,
        ),
        // Recurve bow (Draw): hold to draw, release; speed and damage grow with the draw.
        longwick: (
            draw_time: 0.62,       // feel: snappier draw (was 0.75)
            interval: 0.25,        // after a release
            min_speed: 55.0,       // feel: a tap still flies (was 45)
            max_speed: 135.0,      // feel: flatter, faster full draw (was 120)
            min_damage: 22.0,
            max_damage: 105.0,
            arrow_gravity: 10.0,   // feel: was 14
            arrow_radius: 0.05,
            arrow_lifetime: 4.0,
            ability_power: 1.0,
        ),
        // Ember sprayer (Rapid): a short cone that sets targets alight.
        kiln: (
            range: 13.0,
            cone_degrees: 20.0,    // was 16 deg ...
            interval: 0.08,        // 5 ticks at 60 Hz
            damage: 4.0,           // ... and 3: the weakest primary at everything (docs/balance.md)
            burn_stacks: 1,        // per spray
            ability_power: 0.85,
        ),
        // Abilities (pools per class: docs/arsenal.md; the rework's new ones further down).
        flak: (
            shell_speed: 45.0,
            shell_radius: 0.12,
            burst_distance: 14.0,  // or on contact
            pellets: 10,
            pellet_damage: 9.0,
            ring_degrees: 25.0,
            pellet_range: 14.0,
            cooldown: 1.8,
        ),
        limpet: (
            speed: 24.0,
            gravity: 16.0,
            projectile_radius: 0.12,
            max_live: 3,
            fuse: 20.0,
            explosion_radius: 3.5,
            damage: 40.0,          // 50 every 0.4 s was 85 DPS, three times its siblings
            knockback: 14.0,
            cooldown: 0.9,         // between throws (docs/balance.md)
            detonate_hold: 0.25,   // hold this long: every charge out detonates
        ),
        pinning_arrow: (
            enemy_time: 1.4,
            heavy_time: 0.6,
            heavy_health: 300.0,   // base health from which an enemy counts as heavy
            player_time: 1.0,
            player_slow: 0.5,
            damage_scale: 1.0,
            cooldown: 2.5,
        ),
        // Burn status (the Kiln, a stoked weapon, the Waxwork's burst).
        burn: (
            dps: 5.0,              // per stack: 15/s at the cap (docs/balance.md)
            max_stacks: 3,
            duration: 3.0,         // refreshed by every new stack
            tick_interval: 0.25,   // damage steps
        ),
        // Speed and damage of enemy projectiles come from assets/enemies/*.ron.
        enemy_projectiles: (
            ember_radius: 0.3,
            ember_gravity: 20.0,
            ember_lifetime: 6.0,
            ember_explosion_radius: 2.5,
            ember_knockback: 9.0,
            needle_radius: 0.12,
            needle_gravity: 0.0,
            needle_lifetime: 2.0,
        ),
        // ---- refit (docs/refit.md, docs/arsenal.md "Melee"): the melee weapons ----
        // Swings test an arc in front of the eye (reach from the eye, full aperture), against
        // the hit shapes the swinger saw (lag compensation) with hit assist, line of sight.
        trimmer: (
            damage: 36.0,          // 30: below the scatterguns at 5 m from 3 m in (docs/balance.md)
            interval: 0.32,
            reach: 3.0,
            arc_degrees: 70.0,
            max_targets: 3,        // nearest first; a swing also deflects parryable projectiles
            knockback: 4.0,
            ability_power: 1.0,
        ),
        tamper: (
            damage: 85.0,          // to everything in the arc (75: as the Trimmer, docs/balance.md)
            interval: 0.85,
            reach: 3.4,
            arc_degrees: 100.0,
            knockback: 16.0,
            ability_power: 1.0,
        ),
        // Melee abilities: damage is `damage_scale` x the carrier's primary damage.
        lunge: (
            speed: 16.0,           // impulse along the aim ...
            vertical: 0.35,        // ... keeping this share of its vertical part
            lift: 4.5,             // and at least this upward: it glides (friction stops a ground lunge)
            window: 0.35,          // the first target the body reaches in this time is hit
            reach: 0.8,            // beyond the hit shapes
            damage_scale: 1.5,
            knockback: 10.0,
            cooldown: 3.0,
        ),
        whirl: (
            radius: 3.5,
            damage_scale: 1.5,     // it takes the swing's place now (docs/balance.md)
            knockback: 12.0,       // outward ...
            up: 0.35,              // ... with this upward bias
            cooldown: 4.0,
        ),
        hurl: (
            speed: 30.0,
            gravity: 6.0,
            projectile_radius: 0.25,
            flight_time: 3.0,      // both legs
            damage_scale: 1.5,     // on the way out ...
            knockback: 6.0,
            cooldown: 2.5,
            max_distance: 14.0,    // it turns back this far out (or at the level) ...
            return_speed: 30.0,    // ... homing on the thrower's chest ...
            return_damage_scale: 1.0, // ... hitting each hostile once more for this
            catch_refund: 0.4,     // caught: this much of the cooldown back
        ),
        // The knacks on Q (shared/src/sim/knacks.rs); the Thorn keeps `thorn` above.
        knacks: (
            kindle_flask: (
                charges: 1,
                recharge_time: 14.0,
                speed: 16.0,
                angle_degrees: 15.0,   // lobbed above the aim
                gravity: 16.0,
                projectile_radius: 0.15,
                flight_time: 3.0,
                radius: 3.5,           // the pool where it lands ...
                duration: 4.0,
                heal_rate: 10.0,       // ... heals HP/s (teammates and you; PvP: only you)
                haste_time: 5.0,       // drunk (docs/rework.md): haste for this long ...
                haste_scale: 1.3,      // ... speeds and accelerations x this ...
                haste_heal: 8.0,       // ... and this many HP ...
                haste_heal_interval: 1.0, // ... every this many seconds
            ),
            snare: (
                charges: 2,
                recharge_time: 10.0,
                speed: 12.0,
                gravity: 20.0,
                projectile_radius: 0.15,
                arm_time: 0.6,
                trigger_radius: 1.8,   // the first hostile this close is Pinned ...
                damage: 15.0,          // ... and takes this
                lifetime: 20.0,
                max_live: 2,
            ),
            soot_pot: (
                charges: 1,
                recharge_time: 15.0,
                speed: 18.0,
                gravity: 16.0,
                projectile_radius: 0.15,
                flight_time: 2.0,
                radius: 5.0,           // Moulds can't see into, out of or through the cloud
                duration: 7.0,
            ),
            tallow_skin: (
                charges: 1,
                recharge_time: 16.0,
                duration: 3.0,
                damage_scale: 0.5,     // and no knockback
            ),
            surge: (
                charges: 2,
                recharge_time: 6.0,
                speed: 18.0,           // impulse along the look ...
                vertical: 0.3,         // ... keeping this share of its vertical part
            ),
        ),
        // ---- rework (docs/rework.md, docs/arsenal.md): the sniper and the new abilities ----
        // Lens rifle (Precision): hold to focus, release a hitscan beam (exact).
        lamplighter: (
            focus_time: 0.9,       // to a full focus (starts once off its interval)
            interval: 0.35,        // after a release
            min_damage: 35.0,      // a tap ...
            max_damage: 130.0,     // ... to a full focus (weak points x2 as any ray)
            pierce: 2,             // a full focus passes through the first target ...
            pierce_falloff: 0.7,   // ... into one more behind it, x0.7
            zoom: 0.4,             // scope: tan(fov/2) x this at full focus
            ability_power: 1.0,
        ),
        wickline: (
            range: 34.0,           // hitscan, lag-compensated
            zip_speed: 24.0,       // anchored in the level: one impulse along the line ...
            zip_lift: 4.0,         // ... at least this much of it up
            yank_speed: 16.0,      // a light hostile is yanked to you (x its knockback scale) ...
            player_yank_scale: 0.5, // ... a PvP player at half
            damage: 10.0,
            heavy_health: 300.0,   // from this base health a target yanks you to it instead
            line_time: 0.35,
            cooldown: 4.0,
            miss_cooldown: 0.5,    // a miss: half the cooldown
        ),
        tally: (
            hold_time: 1.2,        // hold ALT at most this long ...
            range: 45.0,
            assist_degrees: 1.5,   // ... marking what the crosshair passes over ...
            max_targets: 4,        // ... up to this many (PvP 3) ...
            damage: 30.0,          // ... released: a shot at each one still in sight
            cooldown: 6.0,
            empty_cooldown: 0.25,  // nothing tallied: a quarter of the cooldown
        ),
        waxwork: (
            duration: 5.0,
            health: 60.0,
            lure_range: 25.0,      // Moulds this close that could see it prefer it to you
            burst_radius: 3.5,     // at its end (or destroyed): hot wax
            burst_damage: 30.0,
            burst_knockback: 8.0,
            burn_stacks: 1,
            cooldown: 10.0,        // from its end
        ),
        bolas: (
            speed: 30.0,
            gravity: 8.0,
            projectile_radius: 0.35,
            flight_time: 2.0,
            damage: 0.0,           // the bind is the point: Pinned (the Pinning Arrow's times)
            link_range: 6.0,       // a second hostile this close to the first is bound too ...
            link_time: 4.0,        // ... and for this long ...
            link_share: 0.6,       // ... this much of the damage either takes hits the other
            cooldown: 5.0,
        ),
        bulwark: (
            width: 2.2,
            height: 1.8,
            distance: 1.2,         // out in front, turning with the aim's yaw ...
            pitch_limit_degrees: 30.0, // ... pitch clamped
            hold_time: 4.0,
            cone_degrees: 110.0,   // hostile hits from this front are absorbed ...
            absorb: 150.0,         // ... until this much, then it shatters
            move_scale: 0.75,      // your speeds while it is up
            cooldown: 6.0,         // from when it drops ...
            broken_cooldown: 9.0,  // ... or this if it shattered
        ),
        stoke: (
            duration: 4.0,         // the primary at x1.6 rate, every hit +1 Burn stack ...
            rate: 1.6,
            burn_stacks: 1,
            kiln_reach: 1.3,       // ... (the Kiln: its cone reaches 30 % further instead) ...
            overheat: 1.5,         // ... then no primary for this long
            cooldown: 10.0,        // from the use
        ),
        lantern: (
            toss_speed: 10.0,
            gravity: 20.0,
            projectile_radius: 0.2,
            duration: 8.0,
            range: 18.0,           // shoots the nearest hostile in sight with your primary ...
            rate_scale: 0.5,       // ... at half its rate ...
            damage_scale: 0.6,     // ... and 0.6x its damage
            kiln_range: 8.0,       // the Kiln's lantern: an 8 m cone
            health: 80.0,          // Moulds may attack it
            cooldown: 12.0,
        ),
        kite: (
            speed: 16.0,
            turn_degrees: 120.0,   // per second, towards the point under your crosshair ...
            steer_time: 4.0,       // ... while ALT is held, at most this long
            flight_time: 7.0,
            projectile_radius: 0.3,
            explosion_radius: 4.5,
            damage: 75.0,
            knockback: 18.0,
            cooldown: 5.0,
        ),
        blink_arrow: (
            window: 1.5,           // ALT while it flies or this long after it sticks: step to it
            exit_speed: 6.0,       // along its flight
            damage_scale: 0.8,     // of a plain arrow at the same draw
            cooldown: 6.0,         // from the blink (or when the window passes)
        ),
        beacon_arrow: (
            damage_scale: 0.6,
            duration: 6.0,
            radius: 16.0,          // hostiles this close to it are revealed ...
            damage_multiplier: 1.15, // ... and take this much more from every player
            cooldown: 8.0,
        ),
        riposte: (
            hold_time: 1.0,
            move_scale: 0.6,
            cone_degrees: 120.0,   // blows and shots from the front are blocked ...
            stagger: 0.8,          // ... melee attackers staggered this long
            damage_scale: 2.0,     // released: a counter-swing at 2x the carrier's swing ...
            per_block: 0.5,        // ... +0.5x per further block ...
            max_scale: 3.0,        // ... at most 3x
            knockback: 12.0,
            cooldown: 4.0,
        ),
    ),
    // Style meter (shared/src/sim/style.rs, docs/gameplay.md "Style", docs/style_modes.md).
    // Points fill the current rank's bar; gains are multiplied by the freshness of the weapon
    // mode / action used.
    style: (
        points_per_rank: 100.0,
        decay_lowest: 4.0,          // points/s at DULL ...
        decay_highest: 30.0,        // ... rising linearly to VELOCIDE
        rank_down_refill: 0.6,      // meter after dropping a rank (fraction of the lower bar)
        rank_grace: 1.0,            // a fresh rank can't be lost for this long
        reset_on_death: true,
        kill: 30.0,
        frag: 100.0,                // PvP player kill (instead of kill)
        headshot: 15.0,
        airkill: 40.0,              // killer airborne
        airshot: 20.0,              // victim airborne (not flying enemies)
        multikill: 40.0,            // per extra kill within the window
        multikill_window: 0.6,
        parry: 60.0,
        return_to_sender: 80.0,     // kill with a parried projectile
        ricochet: 30.0,             // ricochet hit ...
        ricochet_per_bounce: 20.0,  // ... + per extra thorn bounce
        deflect: 30.0,              // a Gust turned a hostile projectile around
        exploded: 20.0,
        slam_kill: 40.0,
        fisted: 30.0,
        close_call_health: 30.0,    // kills under this health ...
        close_call_multiplier: 1.5, // ... score x1.5
        freshness_cost: 0.12,       // per scoring use of a weapon mode / action
        freshness_restore: 0.04,    // to every other one per use
        freshness_regen: 0.02,      // per second, everything
        freshness_min: 0.2,
        stale_threshold: 0.5,       // "STALE" below this
        longshot: 50.0,             // potg: hitscan / arrow kill from ...
        longshot_distance: 40.0,    // ... at least this far (m)
    ),
    // Game modes (shared/src/sim/modes.rs, docs/style_modes.md). Deathmatch respawn delay and
    // spawn protection are combat.respawn_delay / combat.spawn_protection; frag / time limits
    // are match settings.
    modes: (
        sp_death_time: 1.5,         // solo: death cam, then back to the last checkpoint
        downed_time: 15.0,          // co-op: downed, waiting for a revive
        revive_range: 2.5,
        revive_time: 1.5,           // hold USE
        revive_health: 40.0,
        fall_respawn_time: 4.0,     // co-op kill-volume deaths (nothing to revive)
        wipe_respawn_time: 3.0,     // co-op: everyone down -> team back to the checkpoint
        exit_countdown: 10.0,       // co-op: first one in starts it; everyone in ends at once
        knockoff_credit: 3.0,       // DM: kill-volume death this soon after a hit frags the hitter
        scoreboard_interval: 0.25,
        // Results grades, thresholds for S, A, B, C (worse = D); docs/style_modes.md.
        grade_time: (1.0, 1.25, 1.65, 2.2),       // x par time, at most
        grade_kills: (1.0, 0.9, 0.75, 0.5),       // fraction of your share of the enemies
        grade_style: (120.0, 85.0, 60.0, 35.0),   // style points per enemy share
        grade_damage: (1.0, 3.0, 6.0, 10.0),      // damage taken per enemy share, at most
    ),
    // PvE difficulty and co-op scaling (shared/src/sim/difficulty.rs, docs/style_modes.md):
    // campaign encounters and grind waves. Tables are per difficulty:
    // (EASY, NORMAL, HARD, BRUTAL, INFERNO); NORMAL with one player is the reference.
    difficulty: (
        health: (0.7, 1.0, 1.3, 1.65, 2.1),             // enemy health at spawn
        count: (0.75, 1.0, 1.2, 1.4, 1.6),              // enemies per wave
        damage: (0.6, 1.0, 1.25, 1.5, 1.85),            // damage enemies deal
        aggression: (0.8, 1.0, 1.15, 1.3, 1.5),         // cooldowns / recoveries divided by this
        projectile_speed: (0.85, 1.0, 1.1, 1.2, 1.3),
        elite_chance: (0.0, 0.02, 0.06, 0.12, 0.2),     // per spawned Mould
        downed_time: (1.5, 1.0, 0.8, 0.65, 0.5),        // x modes.downed_time
        revive_health: (1.5, 1.0, 0.85, 0.7, 0.55),     // x modes.revive_health
        // Every extra player: x (1 + value (players - 1)). Four players on NORMAL: health and
        // count x2.8, damage x1.3, aggression x1.24 (the old rule was x2.5 / x2.5 only).
        player_health: 0.6,
        player_count: 0.6,
        player_damage: 0.1,
        player_aggression: 0.08,
        player_elite_chance: 0.02,  // added per extra player
        player_downed_time: 0.1,    // downed time x (1 - value (players - 2)) from the 3rd on
        min_downed_time: 4.0,
    ),
    // Grind: endless waves on an arena until everyone is down (shared/src/sim/grind.rs).
    grind: (
        first_delay: 5.0,           // before wave 1
        breather: 6.0,              // between waves; whoever is out comes back after it
        // Wave budget in enemy cost units: base + per_wave (w - 1) + per_wave_sq (w - 1)^2,
        // x difficulty count x players. Wave 1 = 6 Gnawers, wave 10 = 32.5, wave 20 = 73.
        budget_base: 6.0,
        budget_per_wave: 2.4,
        budget_per_wave_sq: 0.06,
        health_per_wave: 0.03,      // enemy health x (1 + value (w - 1)) on top of difficulty
        heavy_every: 5,             // heavy wave: budget x heavy_budget, guaranteed heavies ...
        heavy_budget: 1.25,
        heavy_elite_chance: 0.15,   // ... and more elites
        boss_every: 10,             // a boss-grade elite (a heavy with boss_health x health,
        boss_health: 1.6,           // on top of the elite's x2.5: x4 overall)
        max_alive: 14,              // wave Moulds alive at once ...
        alive_per_player: 5,        // ... + this per extra player; the rest wait their turn
        spawn_burst: 6,             // a wave opens with this many ...
        spawn_interval: 0.35,       // ... then one more every this many seconds
        max_wave_enemies: 150,
        min_spawn_distance: 14.0,   // Moulds appear at least this far from every player
        end_delay: 2.5,             // everyone down -> results after this
        grade_wave: (20.0, 15.0, 10.0, 5.0),    // wave reached for S, A, B, C
        // cost: budget per Mould; from_wave: first normal wave; weight: pick weight; heavy:
        // brought by heavy waves (from heavy_every waves before from_wave) and bosses.
        // Moulds the server doesn't have are skipped.
        roster: [
            (enemy: "gnawer", cost: 1.0, from_wave: 1, weight: 10.0, heavy: false),
            (enemy: "harrier", cost: 1.5, from_wave: 2, weight: 4.0, heavy: false),
            (enemy: "censer", cost: 2.0, from_wave: 3, weight: 5.0, heavy: false),
            (enemy: "snuffer", cost: 1.5, from_wave: 4, weight: 4.0, heavy: false),
            (enemy: "heron", cost: 3.0, from_wave: 6, weight: 3.0, heavy: false),
            (enemy: "bellwether", cost: 4.0, from_wave: 7, weight: 2.0, heavy: false),
            (enemy: "gaoler", cost: 6.0, from_wave: 8, weight: 2.0, heavy: true),
            (enemy: "smelter", cost: 6.0, from_wave: 12, weight: 2.0, heavy: true),
        ],
    ),
    // Gun game (shared/src/sim/gungame.rs): a kill with your tier's weapon moves you up; after
    // the last tier comes the melee `finale`, and a kill with it there wins. A punch kill
    // knocks the victim down `punch_demotes` tiers.
    gun_game: (
        ladder: [
            (weapon: Arclash, abilities: (Wisp, Discharge)),
            (weapon: Kiln, abilities: (Lantern, Discharge)),
            (weapon: Thresher, abilities: (Bolas, Flak)),
            (weapon: Riveter, abilities: (Stoke, Lantern)),
            (weapon: Bellows, abilities: (Gust, Bulwark)),
            (weapon: Tumbler, abilities: (Breach, Gravewell)),
            (weapon: Cinderbox, abilities: (Limpet, Kite)),
            (weapon: Lancet, abilities: (Tally, Waxwork)),
            (weapon: Quill, abilities: (Brand, Wickline)),
            (weapon: Longwick, abilities: (BlinkArrow, PinningArrow)),
            (weapon: Lamplighter, abilities: (Wickline, Waxwork)),
        ],
        finale: (weapon: Trimmer, abilities: (Lunge, Hurl)),
        punch_demotes: 1,
    ),
    // Balance per mode (docs/arsenal.md). `combat` above is the reference; a profile scales
    // it per weapon (primary) and per ability -- `(damage, interval, radius, knockback,
    // speed)`, 1.0 if left out -- then sets absolute `overrides` by field path inside
    // `combat`. `pve`: campaign, grind. `pvp`: deathmatch, gun game. The server sends clients
    // the effective tuning of the match.
    // Reasoning per number: docs/arsenal.md ("Balance profiles"), measured by
    // `cargo run -p shared --release --example balance_report` (docs/balance.md). PvP aims at
    // 0.8-1.6 s to kill for a skilled player at the weapon's range; one-shots only from
    // full-draw bow headshots and full-focus Lamplighter headshots (and a Bellows blast to the
    // head inside 5 m, a full one to the body at point blank, 3 m).
    balance: (
        pve: (
            weapons: {},
            abilities: {},
            overrides: {},
        ),
        pvp: (
            weapons: {
                Tumbler: (damage: 0.9),       // 65 a bomb, as before the PvE raise
                Lancet: (damage: 0.85),
                Bellows: (damage: 0.52),      // 5.7 a pellet: 69 a blast (x1.6 inside 3 m: 110)
                Thresher: (damage: 0.49),     // 4.9 a pellet: 39 a blast, as before
                Cinderbox: (damage: 0.75),
                Longwick: (damage: 0.5, interval: 0.85),
                Kiln: (damage: 0.9),          // 3.6 a spray, as before the PvE raise
                Trimmer: (damage: 0.84),      // 30 a slash: four, 0.95 s, as before the PvE raise
                Tamper: (damage: 0.7),        // 59.5 a swing; its abilities are multiples of it
                Lamplighter: (damage: 0.54, interval: 0.75), // full focus: 70 body, 140 head; 2 body shots in 1.6 s
            },
            abilities: {
                Wisp: (damage: 0.5),
                Discharge: (damage: 0.9),
                Breach: (damage: 0.85),
                Gravewell: (damage: 0.75),
                Flak: (damage: 0.8),
                Limpet: (damage: 0.75),       // 30 a charge, as before the PvE cut
                Riposte: (damage: 0.55),      // 2-3x the swing: on the Tamper at most 98
            },
            overrides: {
                "quill.brand_multiplier": 1.25, // a brand invites everyone in a free-for-all
                // A full Bellows blast inside 3 m kills a body (the stated exception).
                "bellows.point_blank_multiplier": 1.6,
                // The PvE pellets push less (a blast staggers a Mould instead): players keep
                // the old shove.
                "bellows.pellet_knockback": 2.0,
                "thresher.pellet_knockback": 1.5,
                "tally.max_targets": 3,
                // Half damage for 3 s won every even duel (twice every time to kill).
                "knacks.tallow_skin.damage_scale": 0.7,
                "knacks.tallow_skin.duration": 2.0,
            },
        ),
    ),
)
