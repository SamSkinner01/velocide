// VELOCIDE gameplay tuning. Watched at runtime: save to hot-reload. The server is
// authoritative and sends its tuning to clients, so prediction always uses the same values.
// Every section uses defaults for anything left out (see shared/src/tuning.rs); `net` is
// omitted here and uses its code defaults.
//
// Units: metres, m/s, m/s², seconds, degrees. Rationale for each value: docs/movement.md
// (movement) and docs/gameplay.md / docs/combat.md (combat).
// Keep these equal to `MovementTuning::default()` / `CombatTuning::default()` when committing
// (tests check both).
(
    movement: (
        // Body
        radius: 0.4,
        standing_height: 1.8,
        slide_height: 0.9,
        eye_height: 1.6,
        slide_eye_height: 0.75,
        step_height: 0.45,
        max_ground_slope_degrees: 50.0,

        // Ground / air
        ground_speed: 16.0,
        ground_accel: 160.0,          // 0 -> 16 m/s in 0.1 s
        ground_overspeed_decel: 30.0, // bleed-off above ground_speed while running
        ground_friction: 10.0,        // only without input
        ground_stop_speed: 4.0,
        air_accel: 70.0,
        air_max_speed: 16.0,          // air control never adds or removes speed above this
        gravity: 38.0,
        max_fall_speed: 90.0,
        max_speed: 150.0,             // hard safety cap (stacked explosions)
        jump_speed: 14.0,             // ~2.5 m jump
        coyote_time: 0.12,
        jump_buffer_time: 0.12,
        footstep_stride: 2.6,

        // Dash
        dash_speed: 48.0,
        dash_duration: 0.17,          // ~8.8 m per dash
        dash_invuln_time: 0.2,
        dash_charges: 3.0,
        dash_regen_rate: 0.85,        // charges per second
        dash_end_speed: 20.0,
        dash_jump_keep: 0.6,          // dash-jump leaves at 28.8 m/s

        // Slide
        slide_min_speed: 24.0,
        slide_max_speed: 60.0,
        slide_steer_degrees: 70.0,
        slide_slope_accel: 1.0,
        slide_jump_boost: 1.0,

        // Slam
        slam_speed: 75.0,
        slam_min_height: 1.0,
        slam_horizontal_keep: 0.0,
        slam_full_power_height: 15.0,
        slam_bounce_window: 0.2,
        slam_bounce_speed: 21.0,      // ~5.8 m bounce (vs 2.5 m jump)
        slam_bounce_power_bonus: 5.0, // up to ~8.9 m from a full-power slam
        slam_shockwave_radius: 6.0,

        // Walls
        wall_jumps: 3,
        wall_jump_up_speed: 13.0,
        wall_jump_out_speed: 11.0,
        wall_jump_input_speed: 4.0,
        wall_cling_max_fall_speed: 4.0,
        wall_detect_distance: 0.4,

        // Camera feel (client only)
        fov_kick_degrees: 10.0,
        fov_kick_speed: 45.0,
        slide_tilt_degrees: 4.0,
        wall_tilt_degrees: 7.0,
        landing_dip: 0.25,
    ),

    // Combat. HP, metres, m/s, seconds; cones are full apertures in degrees.
    combat: (
        // Player
        max_health: 100.0,
        hard_damage_fraction: 0.35,     // of every hit also lowers the effective max
        hard_damage_recover_delay: 1.5,
        hard_damage_recover_rate: 25.0, // HP/s
        respawn_delay: 2.0,             // default death rule (game modes replace it)
        spawn_protection: 1.5,
        player_head_multiplier: 2.0,    // PvP headshots
        self_damage_fraction: 0.35,     // own explosions (knockback stays full: rocket jumps)
        hitscan_range: 400.0,

        // Fist / parry
        parry_window: 0.2,
        parry_range: 3.0,
        parry_cone_degrees: 70.0,
        parry_close_range: 1.2,          // touching-close: any angle in front
        parry_speed_multiplier: 1.5,
        parry_damage_multiplier: 2.0,
        parry_max_speed: 250.0,          // repeated parries stop speeding a projectile up here
        parry_max_damage: 400.0,         // ... and doubling its (direct / explosion) damage here
        parry_auto_aim_degrees: 15.0,
        parry_auto_aim_range: 80.0,
        parry_hard_damage_clear: 0.5,
        parry_compensate_view_lag: true, // delay parryable hits by the victim's view lag too
        melee_parry_range: 4.0,
        punch_damage: 25.0,
        punch_range: 2.6,
        punch_cone_degrees: 50.0,
        punch_knockback: 10.0,
        punch_cooldown: 0.4,

        // Explosions
        explosion_edge_fraction: 0.3, // 100 % at the centre -> 30 % at the radius
        explosion_up_bias: 0.3,

        // Slam shockwave (radius: movement.slam_shockwave_radius)
        slam_damage: 20.0,
        slam_knockback: 12.0,
        slam_min_power_scale: 0.3,

        blood: (
            heal_fraction: 0.4,       // of damage dealt becomes a heal pool
            melee_heal_fraction: 1.0, // punches and parries
            radius: 3.5,
            lifetime: 0.6,
            death_pool: 25.0,
            death_radius: 4.5,
            death_lifetime: 1.0,
            merge_distance: 1.0,
            merge_window: 0.2,
        ),
        prism: (
            charges: 4,
            recharge_time: 2.5,
            throw_speed: 18.0,
            throw_up_speed: 6.0,
            gravity: 20.0,
            lifetime: 4.0,
            radius: 0.2,
            ricochet_radius: 0.6,
            chain_range: 30.0,
            target_range: 40.0,
            damage_multiplier: 1.5,
            restitution: 0.35,
        ),
        // 1: hitscan sidearm. Alt A Overcharge (hold, release), alt B Fan.
        lancet: (
            damage: 22.0,
            interval: 0.3,
            overcharge_time: 0.8,
            overcharge_min_damage: 25.0,
            overcharge_max_damage: 75.0,
            overcharge_pierce: 5,
            overcharge_cooldown: 0.5,
            fan_shots: 3,
            fan_spread_degrees: 6.0,
            fan_damage: 15.0,
            fan_cooldown: 0.9,
        ),
        // 2: hitscan scattergun. Alt A Slug, alt B Flak (parryable grenade).
        thresher: (
            pellets: 10,
            pellet_damage: 9.0,
            cone_degrees: 7.0,
            interval: 0.75,
            pellet_knockback: 2.0,
            pellet_range: 120.0,
            slug_damage: 70.0,
            slug_cooldown: 1.0,
            slug_knockback: 14.0,
            slug_recoil: 6.0,
            flak_speed: 28.0,
            flak_gravity: 25.0,
            flak_fuse: 1.2,
            flak_radius: 5.0,
            flak_damage: 55.0,
            flak_knockback: 18.0,
            flak_cooldown: 1.0,
            flak_projectile_radius: 0.2,
            flak_parry_speed_multiplier: 2.0,
        ),
        // 3: projectile nailer. Alt A Sawblade, alt B Volley.
        riveter: (
            rivet_speed: 90.0,
            rivet_damage: 8.0,
            rate: 12.0,
            spread_degrees: 1.5,
            rivet_radius: 0.08,
            rivet_lifetime: 2.0,
            saw_speed: 40.0,
            saw_damage: 10.0,
            saw_damage_interval: 0.1,
            saw_bounces: 3,
            saw_lifetime: 3.0,
            saw_cooldown: 1.0,
            saw_radius: 0.35,
            volley_count: 8,
            volley_ring_degrees: 10.0,
            volley_damage: 12.0,
            volley_cooldown: 1.2,
        ),
        // 4: explosive launcher. Alt A Sticky (alt again detonates), alt B Mortar.
        cinderbox: (
            rocket_speed: 45.0,
            rocket_radius: 4.5,
            rocket_damage: 70.0,
            rocket_knockback: 22.0,
            rocket_interval: 0.9,
            rocket_projectile_radius: 0.2,
            rocket_lifetime: 5.0,
            sticky_speed: 30.0,
            sticky_gravity: 20.0,
            sticky_radius: 4.0,
            sticky_damage: 60.0,
            sticky_knockback: 18.0,
            sticky_max: 3,
            sticky_cooldown: 0.2,
            sticky_chain_window: 0.4, // alt within this of a throw throws another; later detonates
            sticky_lifetime: 20.0,
            mortar_speed: 22.0,
            mortar_angle_degrees: 35.0,
            mortar_gravity: 25.0,
            mortar_radius: 7.0,
            mortar_damage: 90.0,
            mortar_knockback: 24.0,
            mortar_cooldown: 2.0,
        ),
        // Speed and damage of enemy projectiles come from assets/enemies/*.ron.
        enemy_projectiles: (
            ember_radius: 0.3,
            ember_gravity: 20.0,
            ember_lifetime: 6.0,
            ember_explosion_radius: 2.5,
            ember_knockback: 9.0,
            needle_radius: 0.12,
            needle_gravity: 0.0,
            needle_lifetime: 2.0,
        ),
    ),
    // Style meter (shared/src/sim/style.rs, docs/gameplay.md "Style", docs/style_modes.md).
    // Points fill the current rank's bar; gains are multiplied by the freshness of the weapon
    // mode / action used.
    style: (
        points_per_rank: 100.0,
        decay_lowest: 4.0,          // points/s at DULL ...
        decay_highest: 30.0,        // ... rising linearly to VELOCIDE
        rank_down_refill: 0.6,      // meter after dropping a rank (fraction of the lower bar)
        rank_grace: 1.0,            // a fresh rank can't be lost for this long
        reset_on_death: true,
        kill: 30.0,
        frag: 100.0,                // PvP player kill (instead of kill)
        headshot: 15.0,
        airkill: 40.0,              // killer airborne
        airshot: 20.0,              // victim airborne (not flying enemies)
        multikill: 40.0,            // per extra kill within the window
        multikill_window: 0.6,
        parry: 60.0,
        return_to_sender: 80.0,     // kill with a parried projectile
        ricochet: 30.0,             // ricochet hit ...
        ricochet_per_bounce: 20.0,  // ... + per extra prism bounce
        exploded: 20.0,
        slam_kill: 40.0,
        fisted: 30.0,
        close_call_health: 30.0,    // kills under this health ...
        close_call_multiplier: 1.5, // ... score x1.5
        freshness_cost: 0.12,       // per scoring use of a weapon mode / action
        freshness_restore: 0.04,    // to every other one per use
        freshness_regen: 0.02,      // per second, everything
        freshness_min: 0.2,
        stale_threshold: 0.5,       // "STALE" below this
    ),
    // Game modes (shared/src/sim/modes.rs, docs/style_modes.md). Deathmatch respawn delay and
    // spawn protection are combat.respawn_delay / combat.spawn_protection; frag / time limits
    // are match settings.
    modes: (
        sp_death_time: 1.5,         // solo: death cam, then back to the last checkpoint
        downed_time: 15.0,          // co-op: downed, waiting for a revive
        revive_range: 2.5,
        revive_time: 1.5,           // hold USE
        revive_health: 40.0,
        fall_respawn_time: 4.0,     // co-op kill-volume deaths (nothing to revive)
        wipe_respawn_time: 3.0,     // co-op: everyone down -> team back to the checkpoint
        exit_countdown: 10.0,       // co-op: first one in starts it; everyone in ends at once
        knockoff_credit: 3.0,       // DM: kill-volume death this soon after a hit frags the hitter
        scoreboard_interval: 0.25,
        // Results grades, thresholds for S, A, B, C (worse = D); docs/style_modes.md.
        grade_time: (1.0, 1.25, 1.65, 2.2),       // x par time, at most
        grade_kills: (1.0, 0.9, 0.75, 0.5),       // fraction of your share of the enemies
        grade_style: (120.0, 85.0, 60.0, 35.0),   // style points per enemy share
        grade_damage: (1.0, 3.0, 6.0, 10.0),      // damage taken per enemy share, at most
    ),
)
