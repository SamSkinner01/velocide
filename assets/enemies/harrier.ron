// Harrier: flying dive-bomber (docs/roster.md). A ragged carrion flyer: wax-skin wings stretched
// over brass ribs (3 m span), a hooked beak, dangling talons and a glowing heart sac under the
// chest (the weak point). It hovers 5-10 m up and circles 8-16 m out; its Dive rears up (wings
// fold back, beak and heart glow red, a shriek), then drops in a straight 3D line at the
// target, raking everyone it passes once; the level ends the dive. Punch it mid-dive to Swat
// it: a parry (heal + style) that knocks it out of the sky, stunned, for 2x punch damage.
//
// `position` is the bottom of its capsule; the hover centre (model origin) is 0.65 m above.
// Format: shared/src/sim/enemy/def.rs (EnemyDef), every field documented in docs/combat.md.
// Units: metres, m/s, seconds, degrees. Local offsets: +X right, +Y up, -Z forward, from the feet.
// This file is also compiled into the game as the built-in Harrier (tests use that copy).
(
    name: "Harrier",
    net_kind: 22,
    model: "harrier",
    // Drawn 1.3x its built size (3.9 m wingspan); the flight capsule stays as it was.
    model_scale: 1.3,
    health: 40.0,
    speed: 15.0,
    acceleration: 32.0,
    turn_rate: 540.0,
    radius: 0.7,
    height: 1.3,
    // Hit shapes (offsets from the feet; the hover centre is 0.65 m up): the body, the neck and
    // beak, the wings in their shallow V (where they are mid-flap), the heart under the chest.
    hit_radius: Some(0.7),
    body_shapes: [
        (a: (0.0, 0.95, -0.55), b: (0.0, 1.0, -1.35), radius: 0.26),
        (a: (-0.3, 0.88, 0.3), b: (-1.8, 1.28, 0.25), radius: 0.32),
        (a: (0.3, 0.88, 0.3), b: (1.8, 1.28, 0.25), radius: 0.32),
    ],
    eye_height: 0.85,
    step_height: 0.0,
    locomotion: Flying(min_height: 5.0, max_height: 10.0),
    knockback_scale: 1.5,
    weak_points: [
        (name: "heart", kind: Core, offset: (0.0, 0.26, -0.2), radius: 0.44, multiplier: 2.5),
    ],
    armour: None,
    attacks: [
        // Up to 0.6 s at 26 m/s (~15 m) along the line to the target's chest + 0.15 s of lead.
        // The whole dive is the Swat window (`parry_strike`): a punch within 3 m (+ its radius)
        // stuns it for 2 s and deals 50 (2x the fist).
        (
            name: "dive",
            kind: Dive,
            range: 20.0,
            min_range: 4.0,
            damage: 20.0,
            knockback: 10.0,
            knockback_up: 0.4,
            windup: 0.7,
            strike: 0.6,
            recover: 0.8,
            cooldown: 2.2,
            windup_move_scale: 0.2,
            track_target: true,
            parry_strike: true,
            parry_stun: 2.0,
            parry_damage: 50.0,
            parry_reach: 3.0,
            lunge: 26.0,
            dive_lead: 0.15,
        ),
    ],
    ai: (
        sight_range: 60.0,
        reaction_time: 0.3,
        lose_target_time: 5.0,
        // Circling band (horizontal distance to the target).
        preferred_range: Some((8.0, 16.0)),
        strafe: true,
        target_stickiness: 0.6,
        aggro_switch_fraction: 0.3,
        retarget_interval: 0.3,
        repath_interval: 0.6,
    ),
    drops: (heat: 15.0, heat_radius: 4.0),
    colors: (
        body: (0.68, 0.64, 0.56),
        accent: (0.62, 0.46, 0.22),
        glow: (1.0, 0.22, 0.12),
        telegraph: (1.0, 0.12, 0.06),
        parry: (1.0, 0.9, 0.1),
    ),
    death_time: 1.0,
)
