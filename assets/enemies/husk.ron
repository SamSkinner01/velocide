// Husk: fodder melee enemy. Runs at the nearest visible player along the nav grid, raises its
// arms (wind-up telegraph: red glint) and swipes. Players who keep running away get lunged at
// (longer wind-up, then a leap that rakes whoever it reaches). Fragile; the head is a weak point.
//
// Format: shared/src/sim/enemy/def.rs (EnemyDef), every field documented in docs/combat.md.
// Units: metres, m/s, seconds, degrees. Local offsets: +X right, +Y up, -Z forward, from the feet.
// This file is also compiled into the game as the built-in Husk (tests use that copy).
(
    name: "Husk",
    net_kind: 16,
    model: "husk",
    health: 40.0,
    speed: 9.0,
    acceleration: 60.0,
    turn_rate: 600.0,
    radius: 0.45,
    height: 1.9,
    // The body hitbox stops at the shoulders; the head sphere sits on top of it.
    body_top: Some(1.45),
    eye_height: 1.65,
    step_height: 0.45,
    locomotion: Ground,
    knockback_scale: 1.3,
    weak_points: [
        (name: "head", kind: Head, offset: (0.0, 1.66, -0.05), radius: 0.26, multiplier: 2.0),
    ],
    armour: None,
    attacks: [
        (
            name: "swipe",
            kind: Melee,
            range: 2.2,
            arc: 120.0,
            damage: 15.0,
            knockback: 7.0,
            windup: 0.45,
            strike: 0.12,
            recover: 0.45,
            cooldown: 0.5,
            windup_move_scale: 0.2,
            track_target: true,
            parry_window: None,
        ),
        // Gap closer: only against targets moving faster than 5 m/s (fleeing / strafing).
        (
            name: "lunge",
            kind: Melee,
            range: 6.5,
            min_range: 2.8,
            arc: 100.0,
            damage: 15.0,
            knockback: 9.0,
            windup: 0.5,
            strike: 0.4,
            recover: 0.6,
            cooldown: 2.5,
            windup_move_scale: 0.0,
            track_target: true,
            parry_window: None,
            lunge: 14.0,
            min_target_speed: 5.0,
        ),
    ],
    ai: (
        sight_range: 60.0,
        reaction_time: 0.35,
        lose_target_time: 4.0,
        preferred_range: None,
        strafe: false,
        target_stickiness: 0.6,
        aggro_switch_fraction: 0.3,
        retarget_interval: 0.25,
        repath_interval: 0.5,
    ),
    drops: (blood_pool: 25.0, blood_radius: 4.5),
    colors: (
        body: (0.55, 0.47, 0.42),
        accent: (0.32, 0.08, 0.07),
        glow: (1.0, 0.25, 0.12),
        telegraph: (1.0, 0.08, 0.04),
        parry: (1.0, 0.9, 0.1),
    ),
    death_time: 0.6,
)
