// Censer: ranged lobber (docs/roster.md). A tall robed Mould whose head is a caged brazier; it
// swings a smoking censer on a long chain. It keeps 14-30 m from its target and side-steps
// slowly; its Volley whirls the censer overhead (embers brighten, the chain rattles) and lobs
// three ember bombs on ballistic arcs onto where the target is heading. Each bursts on impact
// and can be punched back. Anyone who rushes it gets shoved off by a wide censer swing. The
// brazier head is the weak point.
//
// Format: shared/src/sim/enemy/def.rs (EnemyDef), every field documented in docs/combat.md.
// Units: metres, m/s, seconds, degrees. Local offsets: +X right, +Y up, -Z forward, from the feet.
// This file is also compiled into the game as the built-in Censer (tests use that copy).
(
    name: "Censer",
    net_kind: 21,
    model: "censer",
    health: 80.0,
    speed: 5.0,
    acceleration: 40.0,
    turn_rate: 360.0,
    radius: 0.6,
    height: 2.5,
    // The body hitbox stops at the shoulders; the brazier head sits on top of them.
    body_top: Some(1.95),
    eye_height: 2.2,
    step_height: 0.45,
    locomotion: Ground,
    knockback_scale: 1.0,
    weak_points: [
        (name: "lantern", kind: Head, offset: (0.0, 2.22, -0.1), radius: 0.42, multiplier: 2.0),
    ],
    armour: None,
    attacks: [
        // Players inside ~3 m (centre to centre): a 160 degree swing that shoves them away.
        (
            name: "swing",
            kind: Melee,
            range: 2.2,
            arc: 160.0,
            damage: 12.0,
            knockback: 12.0,
            knockback_up: 0.25,
            windup: 0.5,
            strike: 0.15,
            recover: 0.5,
            cooldown: 1.2,
            windup_move_scale: 0.0,
            track_target: true,
        ),
        // Three ember bombs fanned across 16 degrees (+-8), each lobbed on the least-speed arc
        // onto the target's predicted feet (at most 26 m/s; gravity is the bomb's, 20). Each
        // bursts on impact: 2.5 m, 18 damage at the centre with the usual falloff.
        (
            name: "volley",
            kind: Projectile,
            range: 32.0,
            min_range: 4.0,
            damage: 18.0,
            knockback: 0.0,
            windup: 0.8,
            strike: 0.1,
            recover: 0.5,
            cooldown: 3.0,
            windup_move_scale: 0.0,
            track_target: true,
            projectile: Some((
                kind: EmberBomb,
                speed: 26.0,
                count: 3,
                interval: 0.12,
                spread: 16.0,
                muzzle: (0.0, 3.05, -0.35),
                lead: 0.7,
                lob: true,
            )),
        ),
    ],
    ai: (
        sight_range: 60.0,
        reaction_time: 0.45,
        lose_target_time: 5.0,
        preferred_range: Some((14.0, 30.0)),
        strafe: true,
        target_stickiness: 0.6,
        aggro_switch_fraction: 0.3,
        retarget_interval: 0.3,
        repath_interval: 0.8,
    ),
    drops: (heat: 30.0, heat_radius: 4.5),
    colors: (
        body: (0.58, 0.55, 0.5),
        accent: (0.55, 0.4, 0.2),
        glow: (1.0, 0.55, 0.12),
        telegraph: (1.0, 0.45, 0.05),
        parry: (1.0, 0.9, 0.1),
    ),
    death_time: 1.0,
)
