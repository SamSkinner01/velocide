// Gnawer: fodder melee, a pack crawler (docs/roster.md). A hunched Mould that runs on its
// oversized fists, grey wax-flesh over a caged ribcage, a huge under-slung jaw of brass teeth.
// It knuckle-runs at the nearest player and bites (the jaw unhinges, the throat glows orange);
// players who run from it get pounced on (a crouch, then a leaping arc that rakes whoever it
// reaches). The big low head is the weak point.
//
// Format: shared/src/sim/enemy/def.rs (EnemyDef), every field documented in docs/combat.md.
// Units: metres, m/s, seconds, degrees. Local offsets: +X right, +Y up, -Z forward, from the feet.
// This file is also compiled into the game as the built-in Gnawer (tests use that copy).
(
    name: "Gnawer",
    net_kind: 20,
    model: "gnawer",
    health: 45.0,
    speed: 10.0,
    acceleration: 60.0,
    turn_rate: 600.0,
    radius: 0.6,
    height: 2.0,
    // The body hitbox stops at the hunched shoulders; the head juts out in front of them.
    body_top: Some(1.55),
    eye_height: 1.65,
    step_height: 0.45,
    locomotion: Ground,
    knockback_scale: 1.25,
    weak_points: [
        (name: "head", kind: Head, offset: (0.0, 1.62, -0.38), radius: 0.38, multiplier: 2.0),
    ],
    armour: None,
    attacks: [
        (
            name: "bite",
            kind: Melee,
            range: 2.6,
            arc: 100.0,
            damage: 14.0,
            knockback: 7.0,
            windup: 0.4,
            strike: 0.12,
            recover: 0.4,
            cooldown: 0.5,
            windup_move_scale: 0.25,
            track_target: true,
        ),
        // Gap closer against targets moving faster than 4 m/s, 3-9 m away (centre to centre;
        // ranges here are between body surfaces): crouch, then leap 13 m/s forward + 6 m/s up.
        (
            name: "pounce",
            kind: Melee,
            range: 8.0,
            min_range: 2.0,
            arc: 110.0,
            damage: 18.0,
            knockback: 9.0,
            windup: 0.55,
            // The leap and the follow-through run: ~9 m.
            strike: 0.7,
            recover: 0.7,
            cooldown: 3.0,
            windup_move_scale: 0.0,
            track_target: true,
            lunge: 13.0,
            lunge_up: 6.0,
            min_target_speed: 4.0,
        ),
    ],
    ai: (
        sight_range: 60.0,
        reaction_time: 0.35,
        lose_target_time: 4.0,
        preferred_range: None,
        strafe: false,
        target_stickiness: 0.6,
        aggro_switch_fraction: 0.3,
        retarget_interval: 0.25,
        repath_interval: 0.5,
    ),
    drops: (blood_pool: 25.0, blood_radius: 4.5),
    colors: (
        body: (0.66, 0.63, 0.57),
        accent: (0.7, 0.5, 0.2),
        glow: (1.0, 0.5, 0.1),
        telegraph: (1.0, 0.38, 0.04),
        parry: (1.0, 0.9, 0.1),
    ),
    death_time: 0.9,
)
