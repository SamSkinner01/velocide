// Gaoler: the heavy (docs/roster.md). A 3.7 m iron jailer Mould: a riveted cell door for a shield
// on its left arm, a chain flail in its right hand, a grilled helm, and a caged heart-lantern on
// its back - the unarmoured side. Everything from the front is cut to 15 % (explosions too)
// except the helm grille and the lantern.
//
// * Shield Bash (close): the shield draws back, its rim glows yellow; the last 0.35 s is the
//   parry window (white-hot strobe). Parried: the shield is knocked aside, stunned 2.5 s, 150
//   counter damage through the armour.
// * Chain Sweep (within ~7 m): the chain glows red and is spun low; a 300 degree sweep at
//   knee height that only hits players whose feet are less than 1.2 m above the Gaoler's feet.
//   Jump it. Not parryable.
// * Rush (8-20 m away): plants itself, then charges 15 m/s for 0.8 s behind the shield; walls
//   stop it.
//
// Format: shared/src/sim/enemy/def.rs (EnemyDef), every field documented in docs/combat.md.
// Units: metres, m/s, seconds, degrees. Local offsets: +X right, +Y up, -Z forward, from the feet.
// Melee ranges are between body surfaces (the Gaoler is 1.3 m wide each side of its centre).
// This file is also compiled into the game as the built-in Gaoler (tests use that copy).
(
    name: "Gaoler",
    net_kind: 23,
    model: "gaoler",
    health: 520.0,
    speed: 4.5,
    acceleration: 25.0,
    turn_rate: 150.0,
    radius: 1.3,
    height: 3.7,
    // The helm sits on top of the body hitbox.
    body_top: Some(3.0),
    eye_height: 3.3,
    step_height: 0.45,
    locomotion: Ground,
    knockback_scale: 0.12,
    weak_points: [
        (name: "head", kind: Head, offset: (0.0, 3.32, -0.35), radius: 0.45, multiplier: 1.5),
        // The caged heart-lantern on its back: the unarmoured side.
        (name: "lantern", kind: Core, offset: (0.0, 2.2, 0.95), radius: 0.55, multiplier: 2.5),
    ],
    armour: Some((
        front_multiplier: 0.15,
        front_arc: 120.0,
        bypass: ["head", "lantern"],
        explosions: true,
    )),
    attacks: [
        // Reach 2.4 m from its surface (~4.1 m from its centre); parried by a punch within
        // 3.2 m + its radius = 4.5 m of its centre, so anyone it can hit can parry it.
        (
            name: "bash",
            kind: Melee,
            range: 2.4,
            arc: 110.0,
            damage: 40.0,
            knockback: 18.0,
            knockback_up: 0.6,
            windup: 1.0,
            strike: 0.2,
            recover: 0.9,
            cooldown: 1.2,
            windup_move_scale: 0.0,
            track_target: true,
            parry_window: Some(0.35),
            parry_stun: 2.5,
            parry_damage: 150.0,
            parry_reach: 3.2,
        ),
        (
            name: "sweep",
            kind: Melee,
            range: 5.3,
            arc: 300.0,
            damage: 25.0,
            knockback: 14.0,
            knockback_up: 0.3,
            windup: 0.8,
            strike: 0.25,
            recover: 0.8,
            cooldown: 3.5,
            windup_move_scale: 0.0,
            track_target: true,
            jumpable: Some(1.2),
        ),
        (
            name: "rush",
            kind: Melee,
            range: 18.3,
            min_range: 6.3,
            arc: 110.0,
            damage: 30.0,
            knockback: 16.0,
            knockback_up: 0.4,
            windup: 0.9,
            strike: 0.8,
            recover: 0.9,
            cooldown: 5.0,
            windup_move_scale: 0.0,
            track_target: true,
            lunge: 15.0,
        ),
    ],
    ai: (
        sight_range: 60.0,
        reaction_time: 0.6,
        lose_target_time: 6.0,
        preferred_range: None,
        strafe: false,
        target_stickiness: 0.7,
        aggro_switch_fraction: 0.15,
        retarget_interval: 0.4,
        repath_interval: 0.8,
    ),
    drops: (blood_pool: 60.0, blood_radius: 6.0),
    colors: (
        body: (0.36, 0.35, 0.34),
        accent: (0.6, 0.45, 0.2),
        glow: (1.0, 0.62, 0.15),
        telegraph: (1.0, 0.85, 0.1),
        parry: (1.0, 0.95, 0.25),
    ),
    death_time: 1.4,
)
