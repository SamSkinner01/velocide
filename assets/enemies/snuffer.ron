// Snuffer: the skitterer (docs/enemies.md). A low, 2 m long Mould on six jointed brass legs, a
// segmented wax body, and for a head a big brass snuffer cap on a neck: the bell-shaped cone
// that puts candles out. Under the cap glows its wick, the weak point.
//
// * Latch: it rears back, cap lifted and the wick under it blazing, legs bunched, hissing
//   (0.7 s); then leaps (14 m/s + 5 m/s up) and clamps onto the first player it reaches,
//   capping their wick: it clings to their chest, smothering them (16 damage per second, all of
//   it hard damage) and dragging at them (they move at 72 % speed). PUNCH it to throw
//   it off (30 counter damage, its cap knocked open, stunned 1.6 s) or DASH to shake it off
//   (stunned 1 s). A dash through the leap makes it miss. One Snuffer per player: the others
//   nip at you.
// * Nip (close): a quick snap of the cap's rim.
//
// Format: shared/src/sim/enemy/def.rs (EnemyDef), every field documented in docs/combat.md and
// docs/enemies.md. Units: metres, m/s, seconds, degrees. Local offsets: +X right, +Y up,
// -Z forward, from the feet. This file is also compiled into the game as the built-in Snuffer.
(
    name: "Snuffer",
    net_kind: 26,
    model: "snuffer",
    // Drawn 1.3x its built size (2.9 m from tail to cap): it is small and quick; the movement
    // capsule stays as it was.
    model_scale: 1.3,
    health: 70.0,
    speed: 12.5,
    acceleration: 70.0,
    turn_rate: 720.0,
    radius: 0.7,
    height: 1.4,
    // Hit shapes: the body, its long back and tail, the cap (above the wick, so the wick stays
    // open from the front), two bars across the spread of its legs at knee height.
    hit_radius: Some(0.75),
    body_shapes: [
        (a: (0.0, 0.85, 0.2), b: (0.0, 0.9, 1.15), radius: 0.45),
        (a: (0.0, 1.52, -1.38), b: (0.0, 1.75, -1.38), radius: 0.44),
        (a: (-1.15, 0.95, -0.6), b: (1.15, 0.95, -0.6), radius: 0.3),
        (a: (-1.15, 0.95, 0.55), b: (1.15, 0.95, 0.55), radius: 0.3),
    ],
    eye_height: 1.17,
    step_height: 0.45,
    locomotion: Ground,
    knockback_scale: 1.3,
    weak_points: [
        // The wick under the cap, at the front.
        (name: "wick", kind: Head, offset: (0.0, 0.82, -1.32), radius: 0.42, multiplier: 2.5),
    ],
    armour: None,
    attacks: [
        // Leaps from up to ~9 m (centre to centre; ranges here are between body surfaces).
        (
            name: "latch",
            kind: Melee,
            range: 7.8,
            arc: 120.0,
            damage: 6.0,
            knockback: 0.0,
            windup: 0.7,
            strike: 0.6,
            recover: 0.6,
            cooldown: 3.0,
            windup_move_scale: 0.0,
            track_target: true,
            lunge: 14.0,
            lunge_up: 5.0,
            latch: Some((
                damage: 16.0,
                interval: 0.25,
                max_time: 6.0,
                slow: 0.72,
                punch_damage: 30.0,
                punch_stun: 1.6,
                shake_stun: 1.0,
            )),
        ),
        (
            name: "nip",
            kind: Melee,
            range: 1.6,
            arc: 110.0,
            damage: 9.0,
            knockback: 5.0,
            windup: 0.45,
            strike: 0.12,
            recover: 0.4,
            cooldown: 0.6,
            windup_move_scale: 0.2,
            track_target: true,
        ),
    ],
    ai: (
        sight_range: 60.0,
        reaction_time: 0.3,
        lose_target_time: 4.0,
        preferred_range: None,
        strafe: false,
        target_stickiness: 0.6,
        aggro_switch_fraction: 0.3,
        retarget_interval: 0.25,
        repath_interval: 0.5,
    ),
    drops: (heat: 25.0, heat_radius: 4.5),
    colors: (
        body: (0.64, 0.6, 0.54),
        accent: (0.68, 0.5, 0.2),
        glow: (1.0, 0.72, 0.3),
        telegraph: (1.0, 0.5, 0.08),
        parry: (1.0, 0.9, 0.1),
    ),
    death_time: 0.9,
    // Getting there (docs/enemies.md "Leaps, pads, melting"): six spidery legs make it the
    // best climber (4 m ledges, 8 m gaps, a quick 0.25 s crouch); pads; melts and re-forms
    // 8-16 m from its target when stranded for 6 s.
    leap: Some((distance: 8.0, up: 4.0, down: 8.0, crouch: 0.25)),
    pads: true,
    melt: (after: 6.0, sink: 0.6, rise: 0.8, near: 8.0, far: 16.0),
)
